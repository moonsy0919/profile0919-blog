# 환경 변수 예시 파일. 복사해서 .env.local을 만들고 값을 채운다. (.env.local은 커밋하지 않는다)
# 브라우저에 노출해야 하는 값에만 NEXT_PUBLIC_ 접두사를 붙인다.

# 사이트 주소 (메타데이터, sitemap 등에서 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (대시보드 Settings > Data API, Settings > API Keys에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 로그인 보안(서버 전용, NEXT_PUBLIC_ 금지, 배포 환경에도 필요)
# SUPABASE_SERVICE_ROLE_KEY: RLS를 우회하는 비밀 키. 신뢰 IP·차단·인증 코드 테이블을 다루는 서버 코드가 쓴다.
# RESEND_API_KEY: 인증 코드·알림 메일 발송(없으면 개발에서는 콘솔 출력, 운영에서는 로그인 불가).
# AUTH_EMAIL_FROM: 발신 주소(도메인 인증 전에는 비워 두면 onboarding@resend.dev, 계정 소유자 주소로만 발송됨).
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# E2E 인증 테스트용 (로컬 전용, 절대 커밋하지 않는다. 배포 환경·CI에는 두지 않는다)
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
